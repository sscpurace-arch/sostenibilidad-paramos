{"nodes": [{"id": "claudedx", "label": "CLAUDEdx.md \u2014 Instrucciones para agentes IA", "file_type": "document", "source_file": "CLAUDEdx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudedx_app_sostenibilidad_paramos", "label": "App Sostenibilidad P\u00e1ramos (PWA offline-first)", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los t\u00e9cnicos del PNN Purac\u00e9 visitan predios sin internet en el Macizo Colombiano; por eso la app es PWA offline-first con IndexedDB local y sincronizaci\u00f3n diferida a Supabase."}, {"id": "claudedx_offline_first", "label": "Patr\u00f3n offline-first (regla de oro)", "file_type": "rationale", "source_file": "CLAUDEdx.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NUNCA escribir directo a Supabase desde componentes: IndexedDB nunca falla en campo sin se\u00f1al, mientras que la red s\u00ed; toda escritura pasa por saveRecord()/deleteRecord() y una cola de sincronizaci\u00f3n con reintentos."}, {"id": "claudedx_sync_engine", "label": "Sync Engine (lib/sync-engine.js)", "file_type": "code", "source_file": "CLAUDEdx.md", "source_location": "\u00a73, \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motor offline-first: saveRecord \u2192 Dexie put \u2192 sync_queue \u2192 upsert a Supabase si navigator.onLine; m\u00e1ximo 5 reintentos por error y limpieza a las 24h."}, {"id": "claudedx_db_offline", "label": "Esquema Dexie (lib/db-offline.js)", "file_type": "code", "source_file": "CLAUDEdx.md", "source_location": "\u00a72, \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IndexedDB local con versiones 3\u21926; sync_queue solo existe en Dexie (no en Supabase); tabla diagnosticos (v6) sirve de cache offline de la IA."}, {"id": "claudedx_supabase", "label": "Supabase (auth + base de datos remota)", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a74, \u00a76, \u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudedx_rls", "label": "Row Level Security (RLS) en Supabase", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La anon key es p\u00fablica por dise\u00f1o; la seguridad de lectura/escritura/borrado depende enteramente de pol\u00edticas RLS: t\u00e9cnicos solo ven sus propias evaluaciones."}, {"id": "claudedx_edge_function_generar_diagnostico", "label": "Edge Function generar-diagnostico", "file_type": "code", "source_file": "CLAUDEdx.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudedx_diagnostico_ia_gemini", "label": "Diagn\u00f3stico IA con Gemini 2.5", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin GEMINI_API_KEY en .env.local el diagn\u00f3stico corre en modo mock; el resultado se cachea offline en IndexedDB para consulta sin conexi\u00f3n."}, {"id": "claudedx_radarchart", "label": "RadarChart (ApexCharts)", "file_type": "code", "source_file": "CLAUDEdx.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memoizado y con dynamic import ssr:false porque ApexCharts rompe el SSR; labels num\u00e9ricos cortos con leyenda aparte para caber en pantallas m\u00f3viles."}, {"id": "claudedx_pwa_service_worker", "label": "PWA / Service Worker (next-pwa)", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El service worker solo se activa en build de producci\u00f3n; en dev est\u00e1 deshabilitado intencionalmente."}, {"id": "claudedx_geojson_purace", "label": "GeoJSON per\u00edmetro PNN Purac\u00e9 (purace-boundary.json)", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudedx_indicadores_29", "label": "29 indicadores en 3 dimensiones", "file_type": "concept", "source_file": "CLAUDEdx.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cat\u00e1logo de sostenibilidad distribuido en dimensiones Ambiental, Socioecon\u00f3mica y Productiva; vive en la tabla indicadores y se descarga v\u00eda syncInitialData() para no duplicar l\u00f3gica."}], "edges": [{"source": "claudedx", "target": "claudedx_app_sostenibilidad_paramos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDEdx.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "claudedx_offline_first", "target": "claudedx_sync_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDEdx.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "claudedx_app_sostenibilidad_paramos", "target": "claudedx_offline_first", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDEdx.md", "source_location": "\u00a71, \u00a73", "weight": 1.0}, {"source": "claudedx_sync_engine", "target": "claudedx_db_offline", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDEdx.md", "source_location": "\u00a73 (db[tabla].put, sync_queue)", "weight": 1.0}, {"source": "claudedx_sync_engine", "target": "claudedx_supabase", "relation"